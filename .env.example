# 复制为 .env 后再填写真实值；.env 已被 .gitignore 忽略，禁止提交到仓库。
# 本地 IDEA 启动时，Spring Boot 会通过 application.properties 可选导入 demo_bk/.env。
# .env 按 properties 格式书写即可：KEY=value，值不要额外包裹引号。
# JWT密钥推荐使用下面命令生成：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

SERVER_PORT=5090
BLOG_JWT_SECRET=replace-me

# Docker Compose 中 backend 会通过 mysql 服务名连接数据库。
MYSQL_DATABASE=white_jotter
MYSQL_ROOT_PASSWORD=replace-with-root-password
BLOG_DB_URL=jdbc:mysql://mysql:3306/white_jotter?characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
BLOG_DB_USERNAME=blog_user
BLOG_DB_PASSWORD=replace-with-db-password

# Docker Compose 中 backend 会通过 redis 服务名连接 Redis。
BLOG_REDIS_HOST=redis
BLOG_REDIS_PORT=6379
BLOG_REDIS_DATABASE=0
BLOG_REDIS_PASSWORD=replace-with-redis-password

# 容器内文件保存路径和对外访问域名。
BLOG_STORAGE_ROOT=/app/blog-storage
BLOG_FILE_DOMAIN=http://localhost:5090/files
