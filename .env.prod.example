# 正式部署环境示例：复制为 .env.prod 后填写真实值，禁止提交真实文件。
# JWT密钥推荐使用：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=5090
FRONTEND_HTTP_PORT=80
BLOG_CORS_ALLOWED_ORIGINS=https://your-domain.example
BLOG_JWT_SECRET=replace-with-generated-base64-secret

# Docker Compose 中 backend 通过 mysql 服务名连接数据库。
MYSQL_DATABASE=white_jotter
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
BLOG_DB_URL=jdbc:mysql://mysql:3306/white_jotter?characterEncoding=utf8&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
BLOG_DB_USERNAME=blog_user
BLOG_DB_PASSWORD=replace-with-strong-db-password

# Docker Compose 中 backend 通过 redis 服务名连接 Redis。
BLOG_REDIS_HOST=redis
BLOG_REDIS_PORT=6379
BLOG_REDIS_DATABASE=0
BLOG_REDIS_PASSWORD=replace-with-strong-redis-password

# 容器内文件保存路径和对外访问域名。
BLOG_STORAGE_ROOT=/app/blog-storage
BLOG_FILE_DOMAIN=https://your-domain.example/files
BLOG_UPLOAD_MAX_FILE_SIZE=5MB
BLOG_UPLOAD_MAX_REQUEST_SIZE=6MB
BLOG_SCHEDULING_ENABLED=true
