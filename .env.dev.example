# 本地开发环境示例：复制为 .env.dev 后按需修改。
# Maven 直接启动时，也可以复制为 .env，Spring Boot 会自动读取。

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5090
BLOG_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BLOG_JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-bytes

# docker-compose.dev.yml 会创建本地开发数据库和 Redis。
MYSQL_DATABASE=white_jotter
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_HOST_PORT=3306
BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/white_jotter?characterEncoding=utf8&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
BLOG_DB_USERNAME=blog_user
BLOG_DB_PASSWORD=dev-db-password

BLOG_REDIS_HOST=127.0.0.1
BLOG_REDIS_PORT=6379
BLOG_REDIS_DATABASE=0
BLOG_REDIS_PASSWORD=dev-redis-password

BLOG_STORAGE_ROOT=./blog-storage
BLOG_FILE_DOMAIN=http://localhost:5090/files
BLOG_UPLOAD_MAX_FILE_SIZE=5MB
BLOG_UPLOAD_MAX_REQUEST_SIZE=6MB
BLOG_SCHEDULING_ENABLED=true
