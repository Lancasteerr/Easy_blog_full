<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.febrie.demo_bk.dao.BlogArticleDAO">

    <!-- 最新列表未命中缓存时只取 ID，排序与分页仍由 MySQL 负责。 -->
    <select id="selectArticleIdPage"
            resultType="java.lang.Integer">

        SELECT id
        FROM blog_article
        ${ew.customSqlSegment}

    </select>

    <!-- DTO 缓存部分未命中时一次性回表，避免逐篇文章查询。 -->
    <select id="selectArticleListByIds"
            resultType="com.febrie.demo_bk.dto.ArticleListDTO">

        SELECT
            id,
            article_title AS articleTitle,
            article_abstract AS articleAbstract,
            article_date AS articleDate,
            article_cover AS articleCover,
            view_count AS viewCount,
            cover_object_url AS coverURL
        FROM blog_article
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>

    </select>

    <!-- 每次仅加上尚未落库的浏览量增量。 -->
    <update id="incrementViewCount">

        UPDATE blog_article
        SET view_count = view_count + #{delta}
        WHERE id = #{articleId}

    </update>

</mapper>
