<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.febrie.demo_bk.dao.ArticleViewStatDAO">

    <resultMap id="ArticleViewStatResultMap"
               type="com.febrie.demo_bk.pojo.ArticleViewStat">

        <id property="id"
            column="id"/>

        <result property="articleId"
                column="article_id"/>

        <result property="statDate"
                column="stat_date"/>

        <result property="pv"
                column="pv"/>

    </resultMap>


    <insert id="updateViewCount">
        INSERT INTO article_view_stat (
            article_id,
            stat_date,
            pv
        )
        VALUES (
                   #{articleId},
                   #{statDate},
                   #{pvCount}
               )
            ON DUPLICATE KEY UPDATE
                                 pv = #{pvCount}
    </insert>


    <!-- 查询指定日期的文章浏览量 -->
    <select id="selectByStatDate"
            resultMap="ArticleViewStatResultMap">

        SELECT
            id,
            article_id,
            stat_date,
            pv
        FROM article_view_stat
        WHERE stat_date = #{statDate}

    </select>


</mapper>
